expression = input("enter mathematical Expression:").replace(" ","")
def tokenize (arr):
    final = []
    temp = ""

    for idx in range(len(arr)):
        if arr[idx].isdigit() or arr[idx] == ".":
            temp += arr[idx]
        elif arr[idx] == "-" and (idx == 0 or arr[idx-1] in "-*/+"):
            temp += arr[idx]
        elif arr[idx] in "+*-/" and idx != 0:
            final.append(temp)
            temp = ""
            final.append(arr[idx])
    final.append(temp)    
    return final
expression = tokenize(expression)

def solution(arr):
    try:
        for i in range(len(arr)):
            if arr[i] == "*":
                arr[i+1] = float(arr[i-1]) * float(arr[i+1])
            elif arr[i] == "/":
                arr[i+1] = float(arr[i-1]) / float(arr[i+1])
        for i in range(len(arr)):
            if arr[i] == "+":
                arr[i+1] = float(arr[i-1]) + float(arr[i+1])
            elif arr[i] == "-":
                arr[i+1] = float(arr[i-1]) - float(arr[i+1])
        return round(arr[-1],2)
    except (ZeroDivisionError,ValueError,TypeError):
        return "Error maybe you divided by 0 or entered a invalid Expression!"
expression = solution(expression)
print(expression)
while True:
    answer = input("Continue? [Yes/No]: ").lower()
    if answer == "no":
        break
    else:
        expression = input("enter mathematical Expression:").replace(" ","")
        expression = tokenize(expression)
        expression = solution(expression)
        print(expression)
